{
  "name": "himalaya-ui-frontend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "npm run lint:design && tsc --noEmit -p tsconfig.build.json && vite build",
    "lint:design": "node scripts/check-design.mjs",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "e2e": "playwright test",
    "e2e:live": "playwright test -c playwright.live.config.ts",
    "storybook": "storybook dev -p 6006 --no-open",
    "build-storybook": "storybook build"
  },
  "dependencies": {
    "@chenglou/pretext": "^0.0.6",
    "@fontsource/newsreader": "^5.2.10",
    "@fontsource/plus-jakarta-sans": "^5.2.8",
    "@tanstack/react-query": "^5.99.2",
    "d3-scale": "^4.0.2",
    "d3-shape": "^3.2.0",
    "react": "^18.3.0",
    "react-dom": "^18.3.0",
    "react-router-dom": "^6.30.3",
    "zustand": "^4.5.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.48.0",
    "@storybook/react-vite": "^10.4.1",
    "@tailwindcss/vite": "^4.2.4",
    "@testing-library/jest-dom": "^6.5.0",
    "@testing-library/react": "^16.0.0",
    "@testing-library/user-event": "^14.5.0",
    "@types/d3-array": "^3.2.2",
    "@types/d3-format": "^3.0.4",
    "@types/d3-scale": "^4.0.9",
    "@types/d3-shape": "^3.1.8",
    "@types/node": "^25.6.0",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.0",
    "boneyard-js": "^1.8.1",
    "jsdom": "^25.0.0",
    "storybook": "^10.4.1",
    "tailwindcss": "^4.2.4",
    "typescript": "^5.6.0",
    "vite": "^5.4.0",
    "vitest": "^2.1.0"
  }
}
